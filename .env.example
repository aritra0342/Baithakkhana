# Copy this file to .env. Never put DATABASE_URL in a VITE_ variable.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
API_PORT=8787
# Set API_HOST=0.0.0.0 when running behind a production reverse proxy.
APP_ORIGIN=http://127.0.0.1:5173
VITE_ORDER_MODE=demo

# Set these privately while creating each worker, then remove the password from .env.
# WORKER_EMAIL=worker@example.com
# WORKER_NAME=Cafe Worker
# WORKER_ROLE=staff
# WORKER_PASSWORD=use-a-unique-long-password
